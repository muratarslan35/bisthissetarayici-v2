[Unit]
Description=BIST Trading Dashboard Web (Dedicated VM)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Slice=bist-trading.slice
User=@BIST_USER@
Group=@BIST_GROUP@
WorkingDirectory=@BIST_PATH@

Environment=APP_ENV=production
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=BIST_GUNICORN_BIND=127.0.0.1:5000
EnvironmentFile=-@BIST_PATH@/.env
EnvironmentFile=-/etc/bist-trading.env

ExecStart=@BIST_PATH@/venv/bin/gunicorn --config @BIST_PATH@/gunicorn_bist.conf.py app:app
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=45
Restart=always
RestartSec=3

Nice=0
CPUAccounting=true
CPUWeight=100
CPUQuota=50%
MemoryAccounting=true
MemoryHigh=20%
MemoryMax=30%
MemorySwapMax=30%
IOAccounting=true
IOWeight=100
OOMScoreAdjust=200
TasksMax=96

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@BIST_PATH@

[Install]
WantedBy=multi-user.target
