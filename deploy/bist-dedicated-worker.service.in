[Unit]
Description=BIST Trading Scanner Worker (Dedicated VM)
After=network-online.target bist-trading-web.service
Wants=network-online.target

[Service]
Type=simple
Slice=bist-trading.slice
User=@BIST_USER@
Group=@BIST_GROUP@
WorkingDirectory=@BIST_PATH@

Environment=APP_ENV=production
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1

Environment=BIST_MIN_AVAILABLE_MEMORY_MB=160
Environment=BIST_MIN_AVAILABLE_MEMORY_RATIO=0.10
Environment=BIST_MAX_LOAD_PER_CPU=1.75
Environment=BIST_PRESSURE_BACKOFF_SECONDS=10

Environment=TRADING_V3_ENABLED=1
Environment=ENABLE_ULTRA_PRICE_ENGINE=0
Environment=YF_BATCH_SIZE=35
Environment=YF_INTRADAY_TTL_SECONDS=300
Environment=YF_DAILY_TTL_SECONDS=21600

# Dedicated real-time architecture: broad structural scan + narrow fast lane.
Environment=UNIVERSE_REFRESH_SECONDS=900
Environment=UNIVERSE_DAILY_ENRICH_SECONDS=3600
Environment=UNIVERSE_PROMOTED_MAX=140
Environment=UNIVERSE_ENRICH_MAX=360
Environment=FAST_WATCHLIST_SIZE=60
Environment=FAST_POLL_SECONDS=20
Environment=FAST_QUOTE_MAX_AGE_SECONDS=45

# Official KAP ingestion runs independently from Yahoo/full-universe scans.
Environment=KAP_IGS_POLL_SECONDS=20
Environment=KAP_OFF_HOURS_POLL_SECONDS=60
Environment=KAP_WATCH_LOOP_SECONDS=10

EnvironmentFile=-@BIST_PATH@/.env
EnvironmentFile=-/etc/bist-trading.env

ExecStart=@BIST_PATH@/venv/bin/python @BIST_PATH@/worker.py
TimeoutStopSec=45
Restart=always
RestartSec=5

Nice=5
CPUAccounting=true
CPUWeight=100
CPUQuota=150%
MemoryAccounting=true
MemoryHigh=65%
MemoryMax=75%
MemorySwapMax=90%
IOAccounting=true
IOWeight=100
OOMScoreAdjust=600
TasksMax=128

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@BIST_PATH@

[Install]
WantedBy=multi-user.target
